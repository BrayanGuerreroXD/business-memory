{
  "name": "business-memory",
  "version": "0.1.0",
  "description": "Shared business memory for software projects and AI agents",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Brayan Stewart Guerrero Ordoñez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrayanGuerreroXD/business-memory.git"
  },
  "homepage": "https://github.com/BrayanGuerreroXD/business-memory#readme",
  "bugs": { "url": "https://github.com/BrayanGuerreroXD/business-memory/issues" },
  "keywords": [
    "ai-agents",
    "business-rules",
    "documentation",
    "knowledge-base",
    "markdown",
    "cli",
    "claude-code",
    "codex",
    "agent-memory"
  ],
  "engines": { "node": ">=20" },
  "bin": {
    "pm": "./dist/bin.js",
    "business-memory": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/bin.ts --target=node --minify --outfile dist/bin.js",
    "check:node-compat": "bun run scripts/check-bundle.ts",
    "check:startup": "bun run scripts/check-startup.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run check:node-compat && bun run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
